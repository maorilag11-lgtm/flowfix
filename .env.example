# Copy to .env on the deployment host only. Never commit real secrets.
DJANGO_SECRET_KEY=
FLOWFIX_DOMAIN=
DJANGO_ALLOWED_HOSTS=
PUBLIC_URL=
POSTGRES_DB=flowfix
POSTGRES_USER=flowfix
POSTGRES_PASSWORD=
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
BILLING_ENABLED=0
# Set to 0 only when the seller's confirmed tax regime requires no collection.
STRIPE_AUTOMATIC_TAX=1
STRIPE_PORTAL_CONFIGURATION=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BETA_QUOTA=100
PAID_QUOTA=500

# Subscription prices: authoritative Stripe IDs, never browser-provided amounts.
STRIPE_SOLO_MONTHLY_PRICE=
STRIPE_SOLO_ANNUAL_PRICE=
STRIPE_AGENCY_MONTHLY_PRICE=
STRIPE_AGENCY_ANNUAL_PRICE=
STRIPE_ENTERPRISE_MONTHLY_PRICE=
STRIPE_ENTERPRISE_ANNUAL_PRICE=
# Dedicated signed refund endpoint for delivered founders purchases.
STRIPE_LTD_WEBHOOK_SECRET=

# URL HTTPS de la page de vente pour le lien FlowFix des écrans de connexion.
MARKETING_URL=
